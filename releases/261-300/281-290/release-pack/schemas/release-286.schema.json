{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Model Risk Management",
  "type": "object",
  "required": [
    "recordId",
    "modelVersion",
    "riskTier",
    "owner",
    "limitationRefs",
    "evaluationEvidenceRefs",
    "approvedBy",
    "status"
  ],
  "properties": {
    "recordId": {
      "type": "string",
      "minLength": 1
    },
    "modelVersion": {
      "type": "string",
      "minLength": 1
    },
    "riskTier": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "limitationRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "evaluationEvidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "approvedBy": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "restricted",
        "retired"
      ]
    }
  },
  "additionalProperties": false
}