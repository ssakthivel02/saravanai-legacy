{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Enterprise Control Library",
  "type": "object",
  "required": [
    "controlId",
    "title",
    "owner",
    "objective",
    "testProcedureIds",
    "evidenceTypeIds",
    "frameworkMappings",
    "status"
  ],
  "properties": {
    "controlId": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "testProcedureIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "evidenceTypeIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "frameworkMappings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "retired"
      ]
    }
  },
  "additionalProperties": false
}