{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Release Train and Portfolio Orchestration",
  "type": "object",
  "required": [
    "trainId",
    "owner",
    "releaseIds",
    "dependencyRefs",
    "milestoneIds",
    "gateIds",
    "changeWindowId",
    "status"
  ],
  "properties": {
    "trainId": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "releaseIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "dependencyRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "milestoneIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "gateIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "changeWindowId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "planned",
        "executing",
        "paused",
        "completed"
      ]
    }
  },
  "additionalProperties": false
}