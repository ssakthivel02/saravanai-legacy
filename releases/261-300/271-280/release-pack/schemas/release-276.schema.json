{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Learning Assessment and Credential Readiness",
  "type": "object",
  "required": [
    "programmeId",
    "owner",
    "audience",
    "moduleIds",
    "assessmentIds",
    "accessibilityEvidenceRefs",
    "accreditationClaimed",
    "status"
  ],
  "properties": {
    "programmeId": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "moduleIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "assessmentIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "accessibilityEvidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "accreditationClaimed": {
      "const": false
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "retired"
      ]
    }
  },
  "additionalProperties": false
}