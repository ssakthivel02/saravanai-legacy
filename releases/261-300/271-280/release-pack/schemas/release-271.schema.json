{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Enterprise Knowledge Publishing",
  "type": "object",
  "required": [
    "publicationId",
    "tenantId",
    "owner",
    "version",
    "audiences",
    "sourceRefs",
    "reviewedBy",
    "status"
  ],
  "properties": {
    "publicationId": {
      "type": "string",
      "minLength": 1
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "audiences": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "reviewedBy": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "published",
        "corrected",
        "retired"
      ]
    }
  },
  "additionalProperties": false
}