{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Human Task and Approval Orchestration",
  "type": "object",
  "required": [
    "taskId",
    "tenantId",
    "requester",
    "assignee",
    "dueAt",
    "evidenceRefs",
    "escalationRole",
    "status"
  ],
  "properties": {
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "requester": {
      "type": "string",
      "minLength": 1
    },
    "assignee": {
      "type": "string",
      "minLength": 1
    },
    "dueAt": {
      "type": "string",
      "minLength": 1
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "escalationRole": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "open",
        "approved",
        "rejected",
        "expired"
      ]
    }
  },
  "additionalProperties": false
}