{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow Definition and Versioning",
  "type": "object",
  "required": [
    "workflowId",
    "version",
    "owner",
    "stepIds",
    "maximumAttempts",
    "timeoutSeconds",
    "rollbackRef",
    "status"
  ],
  "properties": {
    "workflowId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "stepIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "maximumAttempts": {
      "type": "number",
      "minimum": 0
    },
    "timeoutSeconds": {
      "type": "number",
      "minimum": 0
    },
    "rollbackRef": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "retired"
      ]
    }
  },
  "additionalProperties": false
}