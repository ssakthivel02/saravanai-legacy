{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SakthiAI safety-critical environment",
  "type": "object",
  "required": [
    "PUBLIC_REGISTRATION_ENABLED",
    "PRODUCTION_WRITES_ENABLED",
    "PAID_PROVIDERS_ENABLED",
    "AUTONOMOUS_TOOL_EXECUTION_ENABLED"
  ],
  "properties": {
    "PUBLIC_REGISTRATION_ENABLED": {
      "const": "false"
    },
    "PRODUCTION_WRITES_ENABLED": {
      "enum": [
        "false",
        "true"
      ]
    },
    "PAID_PROVIDERS_ENABLED": {
      "const": "false"
    },
    "AUTONOMOUS_TOOL_EXECUTION_ENABLED": {
      "const": "false"
    },
    "CLOUDFLARE_ACCESS_AUD": {
      "type": "string",
      "minLength": 8
    },
    "OWNER_EMAIL_ALLOWLIST": {
      "type": "string",
      "minLength": 3
    }
  },
  "additionalProperties": true
}