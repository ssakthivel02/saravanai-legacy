{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Technology and Supplier Evaluation",
  "type": "object",
  "required": [
    "evaluationId",
    "candidate",
    "owner",
    "requirementScores",
    "securityEvidence",
    "privacyEvidence",
    "exitPlanId",
    "decision"
  ],
  "properties": {
    "evaluationId": {
      "type": "string",
      "minLength": 1
    },
    "candidate": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "requirementScores": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "securityEvidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "privacyEvidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "exitPlanId": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "shortlist",
        "approve",
        "reject"
      ]
    }
  },
  "additionalProperties": false
}