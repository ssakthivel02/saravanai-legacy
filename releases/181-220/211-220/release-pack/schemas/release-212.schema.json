{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Architecture Portfolio and Technology Radar",
  "type": "object",
  "required": [
    "itemId",
    "technology",
    "ring",
    "owner",
    "decisionRefs",
    "reviewAt",
    "exceptionId"
  ],
  "properties": {
    "itemId": {
      "type": "string",
      "minLength": 1
    },
    "technology": {
      "type": "string",
      "minLength": 1
    },
    "ring": {
      "enum": [
        "adopt",
        "trial",
        "assess",
        "hold"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "decisionRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "reviewAt": {
      "type": "string",
      "minLength": 1
    },
    "exceptionId": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}