{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scenario Intelligence and Forecasting",
  "type": "object",
  "required": [
    "scenarioId",
    "name",
    "assumptions",
    "evidenceRefs",
    "confidence",
    "triggerIndicators",
    "reviewedBy",
    "status"
  ],
  "properties": {
    "scenarioId": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0
    },
    "triggerIndicators": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "reviewedBy": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "reviewed",
        "retired"
      ]
    }
  },
  "additionalProperties": false
}