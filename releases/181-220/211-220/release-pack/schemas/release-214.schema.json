{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Board Decision and Accountability Records",
  "type": "object",
  "required": [
    "decisionId",
    "title",
    "accountableOwner",
    "alternatives",
    "evidenceRefs",
    "conflictDeclarations",
    "approvedBy",
    "reviewAt"
  ],
  "properties": {
    "decisionId": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "accountableOwner": {
      "type": "string",
      "minLength": 1
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "conflictDeclarations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "approvedBy": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "reviewAt": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}