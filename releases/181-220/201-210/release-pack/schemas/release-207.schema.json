{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fraud Account Abuse and Misuse Prevention",
  "type": "object",
  "required": [
    "caseId",
    "tenantId",
    "category",
    "riskScore",
    "signalRefs",
    "action",
    "appealAvailable",
    "owner"
  ],
  "properties": {
    "caseId": {
      "type": "string",
      "minLength": 1
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "riskScore": {
      "type": "number",
      "minimum": 0
    },
    "signalRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "action": {
      "enum": [
        "monitor",
        "limit",
        "suspend",
        "close"
      ]
    },
    "appealAvailable": {
      "const": true
    },
    "owner": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}