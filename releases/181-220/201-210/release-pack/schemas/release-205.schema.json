{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Identity Threat Detection and Response",
  "type": "object",
  "required": [
    "signalId",
    "tenantId",
    "subject",
    "signalType",
    "riskScore",
    "requestIds",
    "observedAt",
    "status"
  ],
  "properties": {
    "signalId": {
      "type": "string",
      "minLength": 1
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "signalType": {
      "type": "string",
      "minLength": 1
    },
    "riskScore": {
      "type": "number",
      "minimum": 0
    },
    "requestIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "observedAt": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "open",
        "contained",
        "resolved"
      ]
    }
  },
  "additionalProperties": false
}