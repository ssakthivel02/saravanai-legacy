{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Global Trust and Resilience Assurance Gate",
  "type": "object",
  "required": [
    "gateId",
    "releaseRange",
    "securityEvidence",
    "regionalEvidence",
    "recoveryEvidence",
    "transparencyEvidence",
    "decision"
  ],
  "properties": {
    "gateId": {
      "type": "string",
      "minLength": 1
    },
    "releaseRange": {
      "type": "string"
    },
    "securityEvidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "regionalEvidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "recoveryEvidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "transparencyEvidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "decision": {
      "enum": [
        "pending",
        "go",
        "conditional_go",
        "no_go"
      ]
    }
  },
  "additionalProperties": false
}