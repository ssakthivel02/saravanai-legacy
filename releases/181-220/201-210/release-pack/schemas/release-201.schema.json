{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Geopolitical and Regional Risk Intelligence",
  "type": "object",
  "required": [
    "profileId",
    "region",
    "owner",
    "dependencyRefs",
    "riskFactors",
    "localReviewRequired",
    "reviewedAt",
    "status"
  ],
  "properties": {
    "profileId": {
      "type": "string",
      "minLength": 1
    },
    "region": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "dependencyRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "riskFactors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "localReviewRequired": {
      "type": "boolean"
    },
    "reviewedAt": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "normal",
        "elevated",
        "restricted"
      ]
    }
  },
  "additionalProperties": false
}