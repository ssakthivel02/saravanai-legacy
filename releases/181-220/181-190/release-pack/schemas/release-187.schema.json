{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Safety Incident and Abuse Investigation",
  "type": "object",
  "required": [
    "caseId",
    "tenantId",
    "category",
    "severity",
    "requestIds",
    "evidenceRefs",
    "owner",
    "status"
  ],
  "properties": {
    "caseId": {
      "type": "string",
      "minLength": 1
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "requestIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "open",
        "contained",
        "resolved",
        "closed"
      ]
    }
  },
  "additionalProperties": false
}