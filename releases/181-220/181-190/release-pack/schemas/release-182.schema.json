{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prompt and Policy Lifecycle",
  "type": "object",
  "required": [
    "policyId",
    "version",
    "owner",
    "contentHash",
    "testSuiteIds",
    "approvedBy",
    "effectiveFrom",
    "retiredAt"
  ],
  "properties": {
    "policyId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "contentHash": {
      "type": "string",
      "minLength": 1
    },
    "testSuiteIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "approvedBy": {
      "type": [
        "string",
        "null"
      ]
    },
    "effectiveFrom": {
      "type": "string",
      "minLength": 1
    },
    "retiredAt": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}