{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Enterprise Integration Orchestration",
  "type": "object",
  "required": [
    "flowId",
    "tenantId",
    "owner",
    "steps",
    "compensationSteps",
    "maximumAttempts",
    "timeoutSeconds",
    "enabled"
  ],
  "properties": {
    "flowId": {
      "type": "string",
      "minLength": 1
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "compensationSteps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "maximumAttempts": {
      "type": "number",
      "minimum": 0
    },
    "timeoutSeconds": {
      "type": "number",
      "minimum": 0
    },
    "enabled": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}