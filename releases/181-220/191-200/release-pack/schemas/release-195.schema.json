{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Data Quality Observability",
  "type": "object",
  "required": [
    "resultId",
    "assetId",
    "ruleId",
    "score",
    "failedRows",
    "observedAt",
    "owner",
    "status"
  ],
  "properties": {
    "resultId": {
      "type": "string",
      "minLength": 1
    },
    "assetId": {
      "type": "string",
      "minLength": 1
    },
    "ruleId": {
      "type": "string",
      "minLength": 1
    },
    "score": {
      "type": "number",
      "minimum": 0
    },
    "failedRows": {
      "type": "number",
      "minimum": 0
    },
    "observedAt": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "pass",
        "warn",
        "fail"
      ]
    }
  },
  "additionalProperties": false
}