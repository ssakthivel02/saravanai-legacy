{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Enterprise Data Mesh Governance",
  "type": "object",
  "required": [
    "domainId",
    "tenantId",
    "name",
    "owner",
    "productIds",
    "policyIds",
    "qualityObjectiveIds",
    "status"
  ],
  "properties": {
    "domainId": {
      "type": "string",
      "minLength": 1
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "productIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "policyIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "qualityObjectiveIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "status": {
      "enum": [
        "active",
        "deprecated"
      ]
    }
  },
  "additionalProperties": false
}