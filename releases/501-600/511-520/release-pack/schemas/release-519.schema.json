{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Media Accessibility and Localisation",
  "type": "object",
  "required": [
    "profileId",
    "tenantId",
    "owner",
    "policyRefs",
    "controlRefs",
    "evidenceRefs",
    "reviewAt",
    "status"
  ],
  "properties": {
    "profileId": {
      "type": "string",
      "minLength": 1
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "policyRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "controlRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "reviewAt": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "restricted",
        "retired"
      ]
    }
  },
  "additionalProperties": false
}