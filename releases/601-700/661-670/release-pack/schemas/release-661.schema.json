{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Telemetry Contract and Signal Registry",
  "type": "object",
  "required": [
    "recordId",
    "tenantId",
    "name",
    "owner",
    "version",
    "sourceRefs",
    "reviewAt",
    "status"
  ],
  "properties": {
    "recordId": {
      "type": "string",
      "minLength": 1
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "reviewAt": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "retired"
      ]
    }
  },
  "additionalProperties": false
}