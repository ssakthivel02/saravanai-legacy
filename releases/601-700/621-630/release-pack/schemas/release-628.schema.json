{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge Conflict and Canonical Resolution",
  "type": "object",
  "required": [
    "decisionId",
    "accountableOwner",
    "alternatives",
    "evidenceRefs",
    "conflictDeclarations",
    "conditions",
    "approvedBy",
    "reviewAt",
    "decision"
  ],
  "properties": {
    "decisionId": {
      "type": "string",
      "minLength": 1
    },
    "accountableOwner": {
      "type": "string",
      "minLength": 1
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "conflictDeclarations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "approvedBy": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "reviewAt": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "pending",
        "go",
        "conditional_go",
        "no_go"
      ]
    }
  },
  "additionalProperties": false
}