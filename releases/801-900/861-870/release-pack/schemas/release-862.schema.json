{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Regional Feature and Data Routing Runtime",
  "type": "object",
  "required": [
    "executionId",
    "tenantId",
    "actorSubject",
    "purpose",
    "idempotencyKey",
    "maximumSteps",
    "approvalId",
    "dryRun",
    "productionWriteAllowed",
    "killSwitchAvailable",
    "status"
  ],
  "properties": {
    "executionId": {
      "type": "string",
      "minLength": 1
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "actorSubject": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1
    },
    "maximumSteps": {
      "type": "number",
      "minimum": 0
    },
    "approvalId": {
      "type": [
        "string",
        "null"
      ]
    },
    "dryRun": {
      "type": "boolean"
    },
    "productionWriteAllowed": {
      "const": false
    },
    "killSwitchAvailable": {
      "const": true
    },
    "status": {
      "enum": [
        "planned",
        "running",
        "completed",
        "failed",
        "cancelled"
      ]
    }
  },
  "additionalProperties": false
}