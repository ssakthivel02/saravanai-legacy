{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Runbook and Remediation Orchestration",
  "type": "object",
  "required": [
    "recordId",
    "tenantId",
    "owner",
    "status",
    "evidenceRefs",
    "riskScore",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "recordId": {
      "type": "string",
      "minLength": 1
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "retired"
      ]
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "riskScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    }
  },
  "additionalProperties": false
}